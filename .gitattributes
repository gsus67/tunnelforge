# Go genera y formatea sus fuentes y módulos con LF. Fuerza LF también en
# checkout de Windows para que gofmt y go mod tidy -diff no fallen por una
# conversión CRLF que no representa ningún cambio real de código.
*.go text eol=lf
conectar-gateway/go.mod text eol=lf
conectar-gateway/go.sum text eol=lf
