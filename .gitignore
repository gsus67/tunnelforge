# Binarios compilados (se publican en Releases, no en el repo)
*.exe
tunnelforge-linux

# Datos personales del operador (IPs, huellas): NUNCA al repo
conexiones.json

# Recursos generados por el workflow
*.syso

# Artefactos de Wails/TypeScript
# Wails genera frontend/dist durante el build, pero Go necesita que el patrón
# go:embed tenga al menos un archivo antes de generar bindings. Por eso se
# conserva únicamente .keep en Git.
conectar-gateway/frontend/dist/*
!conectar-gateway/frontend/dist/.keep
conectar-gateway/frontend/node_modules/
conectar-gateway/frontend/wailsjs/
conectar-gateway/build/bin/

# WireGuard local: puede contener claves privadas o configs runtime
conectar-gateway/wireguard.json
conectar-gateway/wireguard-runtime/
# WireGuard embebido: los DLL oficiales se preparan durante el build de Windows
conectar-gateway/wireguard-assets/windows/amd64/*.dll
.wireguard-upstream/
